{
  "name": "campaign-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Retail marketing elements campaign tracker (web app + Android APK via Capacitor)",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "android:add": "npx cap add android",
    "android:icons": "npx @capacitor/assets generate --android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
